@model FeedbackIndexViewModel
@{
    ViewData["Title"] = "Góp ý";
}

<div class="page-shell">
    <div class="page-head">
        <div>
            <h1>
                <span class="ico"><i class="bi bi-chat-heart"></i></span>
                Góp ý & Thảo luận
            </h1>
            <p class="sub"><span>Gửi góp ý và trao đổi công khai — ai cũng có thể phản hồi lẫn nhau.</span></p>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header grad"><i class="bi bi-send-fill"></i> Gửi góp ý mới</div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label small fw-semibold d-block">Đánh giá</label>
                            <div class="star-input fs-3">
                                @for (var i = 5; i >= 1; i--)
                                {
                                    <input type="radio" name="rating" id="star@(i)" value="@i" @(i == 5 ? "checked" : "") />
                                    <label for="star@(i)" title="@i sao"><i class="bi bi-star-fill"></i></label>
                                }
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Nội dung góp ý</label>
                            <textarea name="content" class="form-control" rows="4" maxlength="2000"
                                      placeholder="Chia sẻ trải nghiệm, đề xuất hoặc vấn đề bạn gặp phải..." required></textarea>
                        </div>
                        <button class="btn btn-brand w-100"><i class="bi bi-send me-1"></i>Gửi góp ý</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-chat-square-text text-primary"></i>Tất cả góp ý
                    <span class="badge bg-primary-subtle ms-1">@Model.Threads.Count</span>
                </div>
                <div class="card-body">
                    @if (Model.Threads.Count == 0)
                    {
                        <div class="text-center p-4 text-muted">
                            <i class="bi bi-inbox" style="font-size:48px; opacity:.35; color: var(--c-primary);"></i>
                            <p class="mt-2 mb-0">Chưa có góp ý nào. Hãy là người đầu tiên!</p>
                        </div>
                    }
                    else
                    {
                        foreach (var thread in Model.Threads)
                        {
                            var card = new FeedbackThreadCardViewModel
                            {
                                Thread = thread,
                                CurrentUserId = Model.CurrentUserId,
                                IsAdmin = Model.IsAdmin,
                                ReturnAction = "Index"
                            };
                            <partial name="_FeedbackThread" model="card" />
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .star-input { display: inline-flex; flex-direction: row-reverse; gap: .15rem; }
    .star-input input { display: none; }
    .star-input label { color: var(--c-border, #d0d5dd); cursor: pointer; transition: color .15s; }
    .star-input label:hover,
    .star-input label:hover ~ label,
    .star-input input:checked ~ label { color: #f5b301; }
</style>
