@model DocumentIndexViewModel
@{
    ViewData["Title"] = "Tài liệu";
    var isAdmin = User.IsInRole("Admin");
    var isLecturer = User.IsInRole("Lecturer");
    var canUpload = isAdmin || isLecturer;
}

<div class="page-shell">
    <div class="page-head">
        <div>
            <h1>
                <span class="ico"><i class="bi bi-folder2-open"></i></span>
                Quản lý tài liệu
            </h1>
            <p class="sub">
                @if (canUpload)
                {
                    <span>Upload PDF/DOCX/PPTX/TXT để bot có thể trả lời từ tài liệu</span>
                }
                else
                {
                    <span>Bạn đang xem chế độ chỉ đọc — chỉ Lecturer và Admin được upload tài liệu</span>
                }
            </p>
        </div>
        <a class="btn btn-brand" asp-controller="Chat" asp-action="Index">
            <i class="bi bi-chat-dots me-1"></i>Sang hỏi đáp
        </a>
    </div>

    <div class="row g-3">
        @if (canUpload)
        {
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header grad">
                        <i class="bi bi-cloud-upload-fill"></i> Upload tài liệu
                    </div>
                    <div class="card-body">
                        <form asp-action="Upload" method="post" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Môn học</label>
                                <select name="subjectId" class="form-select" required>
                                    <option value="">-- Chọn môn --</option>
                                    @foreach (var s in Model.Subjects)
                                    {
                                        <option value="@s.Id" selected="@(Model.SelectedSubjectId == s.Id)">@s.Code - @s.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Tiêu đề tài liệu</label>
                                <input name="title" class="form-control" maxlength="500"
                                       placeholder="VD: Slide chương 1 - Tổng quan ASP.NET" />
                                <div class="form-text">Để trống sẽ tự lấy theo tên tệp.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Tệp tài liệu</label>
                                <label class="upload-dropzone d-block" for="fileInput">
                                    <div class="ico"><i class="bi bi-cloud-arrow-up-fill"></i></div>
                                    <div class="fw-semibold">Kéo thả tệp vào đây hoặc bấm chọn</div>
                                    <div class="form-text mt-1">PDF, DOCX, PPTX, TXT · Tối đa <strong>2 GB</strong></div>
                                    <input id="fileInput" type="file" name="file" class="form-control" accept=".pdf,.docx,.pptx,.txt" required />
                                </label>
                            </div>
                            <button class="btn btn-brand w-100"><i class="bi bi-upload me-1"></i>Upload & Index</button>
                        </form>
                    </div>
                </div>

                @if (isAdmin)
                {
                    <div class="card mt-3">
                        <div class="card-header"><i class="bi bi-book text-primary"></i>Tạo môn học mới</div>
                        <div class="card-body">
                            <form asp-action="CreateSubject" method="post">
                                <div class="mb-2"><input name="code" class="form-control" placeholder="Mã (vd: PRN222)" required /></div>
                                <div class="mb-2"><input name="name" class="form-control" placeholder="Tên môn" required /></div>
                                <div class="mb-2"><textarea name="description" class="form-control" placeholder="Mô tả" rows="2"></textarea></div>
                                <button class="btn btn-outline-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm môn</button>
                            </form>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header"><i class="bi bi-pencil-square text-primary"></i>Quản lý môn học</div>
                        <div class="card-body p-0">
                            @if (Model.Subjects.Count == 0)
                            {
                                <div class="text-center text-muted p-3 small">Chưa có môn học nào.</div>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var s in Model.Subjects)
                                    {
                                        <li class="list-group-item">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="text-truncate me-2">
                                                    <span class="badge bg-light text-dark me-1">@s.Code</span>@s.Name
                                                </div>
                                                <div class="btn-group flex-shrink-0">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#editSubj-@s.Id" title="Sửa">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <form asp-action="DeleteSubject" method="post" class="m-0"
                                                          onsubmit="return confirm('Xoá môn @s.Code? Toàn bộ tài liệu và chunk của môn này cũng sẽ bị xoá.');">
                                                        <input type="hidden" name="id" value="@s.Id" />
                                                        <button class="btn btn-sm btn-outline-danger" title="Xoá"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                </div>
                                            </div>
                                            <div class="collapse mt-2" id="editSubj-@s.Id">
                                                <form asp-action="EditSubject" method="post">
                                                    <input type="hidden" name="id" value="@s.Id" />
                                                    <div class="mb-2"><input name="code" class="form-control form-control-sm" value="@s.Code" required /></div>
                                                    <div class="mb-2"><input name="name" class="form-control form-control-sm" value="@s.Name" required /></div>
                                                    <div class="mb-2"><textarea name="description" class="form-control form-control-sm" rows="2">@s.Description</textarea></div>
                                                    <button class="btn btn-sm btn-primary w-100"><i class="bi bi-check-lg me-1"></i>Lưu thay đổi</button>
                                                </form>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <div class="@(canUpload ? "col-lg-8" : "col-12")">
            <div class="card">
                <div class="card-header justify-content-between">
                    <span><i class="bi bi-files text-primary"></i>Danh sách tài liệu <span class="badge bg-primary-subtle ms-1">@Model.Documents.Count</span></span>
                    <form method="get" class="d-flex gap-2 m-0 flex-wrap">
                        <div class="input-group input-group-sm" style="min-width:220px;">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" name="q" value="@Model.SearchQuery" class="form-control form-control-sm"
                                   placeholder="Tìm theo tên môn, tiêu đề..." />
                        </div>
                        <select name="subjectId" class="form-select form-select-sm" onchange="this.form.submit()" style="min-width:170px;">
                            <option value="">Tất cả môn</option>
                            @foreach (var s in Model.Subjects)
                            {
                                <option value="@s.Id" selected="@(Model.SelectedSubjectId == s.Id)">@s.Code - @s.Name</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-brand" type="submit"><i class="bi bi-search me-1"></i>Tìm</button>
                        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || !string.IsNullOrWhiteSpace(Model.SelectedSubjectId))
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Index" title="Xoá bộ lọc"><i class="bi bi-x-lg"></i></a>
                        }
                    </form>
                </div>
                <div class="card-body p-0">
                    @if (Model.Documents.Count == 0)
                    {
                        <div class="text-center p-5 text-muted">
                            <i class="bi bi-inbox" style="font-size:56px; opacity:.35; color: var(--c-primary);"></i>
                            <p class="mt-3 mb-0">Chưa có tài liệu nào @(string.IsNullOrEmpty(Model.SelectedSubjectId) ? "" : "trong môn học này").</p>
                            @if (canUpload)
                            {
                                <p class="small mt-1">Upload file đầu tiên ở khung bên trái để bắt đầu.</p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Tiêu đề / Tệp</th>
                                        <th>Môn</th>
                                        <th class="text-end">Kích thước</th>
                                        <th class="text-end">Chunks</th>
                                        <th>Upload lúc</th>
                                        <th class="text-end">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model.Documents)
                                    {
                                        var subject = Model.Subjects.FirstOrDefault(s => s.Id == d.SubjectId);
                                        var ext = System.IO.Path.GetExtension(d.FileName).ToLowerInvariant();
                                        var (iconClass, fileType) = ext switch
                                        {
                                            ".pdf" => ("pdf", "bi-file-earmark-pdf-fill"),
                                            ".docx" => ("docx", "bi-file-earmark-word-fill"),
                                            ".pptx" => ("pdf", "bi-file-earmark-slides-fill"),
                                            _ => ("txt", "bi-file-earmark-text-fill")
                                        };
                                        <tr class="doc-row">
                                            <td>
                                                <span class="file-icon @iconClass"><i class="bi @fileType"></i></span>
                                                <a asp-action="Open" asp-route-id="@d.Id" target="_blank" rel="noopener"
                                                   class="fw-bold text-decoration-none" title="Mở tài liệu trong tab mới">
                                                    @(string.IsNullOrWhiteSpace(d.Title) ? d.FileName : d.Title)
                                                </a>
                                                @if (!string.IsNullOrWhiteSpace(d.Title))
                                                {
                                                    <div class="small text-muted ms-4 ps-1">@d.FileName</div>
                                                }
                                            </td>
                                            <td><span class="badge bg-light">@(subject?.Code ?? "?")</span></td>
                                            <td class="text-end small">@($"{d.FileSize / 1024.0 / 1024.0:F2} MB")</td>
                                            <td class="text-end"><span class="badge bg-primary-subtle">@d.ChunkCount</span></td>
                                            <td class="small text-muted">@d.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="text-end">
                                                <div class="btn-group">
                                                    <a asp-action="Open" asp-route-id="@d.Id" target="_blank" rel="noopener"
                                                       class="btn btn-sm btn-outline-primary" title="Mở tài liệu">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a asp-action="Open" asp-route-id="@d.Id" asp-route-download="true"
                                                       class="btn btn-sm btn-outline-secondary" title="Tải về">
                                                        <i class="bi bi-download"></i>
                                                    </a>
                                                    @if (canUpload)
                                                    {
                                                        <form asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('Xoá tài liệu này?');">
                                                            <input type="hidden" name="id" value="@d.Id" />
                                                            <input type="hidden" name="subjectId" value="@Model.SelectedSubjectId" />
                                                            <button class="btn btn-sm btn-outline-danger" title="Xoá"><i class="bi bi-trash"></i></button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Hide native file input inside dropzone for cleaner look */
    .upload-dropzone input[type=file] {
        font-size: .82rem;
        background: white;
        border: 1px solid var(--c-border);
    }
</style>
