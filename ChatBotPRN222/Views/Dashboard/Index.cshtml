@model ServiceLayer.Dtos.DashboardStats
@{
    ViewData["Title"] = "Dashboard";

    string FmtSize(long bytes)
    {
        if (bytes >= 1024L * 1024 * 1024) return $"{bytes / 1024.0 / 1024.0 / 1024.0:F2} GB";
        return $"{bytes / 1024.0 / 1024.0:F2} MB";
    }

    var stats = new[]
    {
        ("bi-people-fill",        "indigo",  Model.UsersTotal.ToString(),   "Người dùng",  $"{Model.Admins} admin · {Model.Lecturers} GV · {Model.Students} SV"),
        ("bi-book-fill",          "blue",    Model.Subjects.ToString(),     "Môn học",     ""),
        ("bi-folder-fill",        "violet",  Model.Documents.ToString(),    "Tài liệu",    FmtSize(Model.DocumentBytes)),
        ("bi-collection-fill",    "teal",    Model.Chunks.ToString(),       "Chunks",      "đã index cho AI"),
        ("bi-chat-dots-fill",     "amber",   Model.ChatSessions.ToString(), "Phiên chat",  $"{Model.ChatMessages} tin nhắn"),
        ("bi-chat-heart-fill",    "rose",    Model.FeedbackTotal.ToString(),"Góp ý",       $"TB {Model.FeedbackAverage:0.0}★ · {Model.FeedbackAwaiting} chờ phản hồi"),
    };
}

<div class="page-shell">
    <div class="page-head">
        <div>
            <h1>
                <span class="ico"><i class="bi bi-speedometer2"></i></span>
                Bảng điều khiển
            </h1>
            <p class="sub"><span>Tổng quan toàn hệ thống ChatBot PRN222.</span></p>
        </div>
        <a class="btn btn-brand" asp-controller="Feedback" asp-action="Manage">
            <i class="bi bi-inboxes me-1"></i>Quản lý góp ý
        </a>
    </div>

    <div class="row g-3">
        @foreach (var (icon, color, value, label, sub) in stats)
        {
            <div class="col-6 col-lg-4 col-xl-2">
                <div class="card h-100 stat-card">
                    <div class="card-body text-center">
                        <div class="stat-ico stat-@color"><i class="bi @icon"></i></div>
                        <div class="h3 mb-0 mt-2">@value</div>
                        <div class="fw-semibold small">@label</div>
                        @if (!string.IsNullOrEmpty(sub))
                        {
                            <div class="text-muted" style="font-size:.72rem;">@sub</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header justify-content-between">
                    <span><i class="bi bi-clock-history text-primary"></i>Tài liệu mới nhất</span>
                    <a class="small" asp-controller="Document" asp-action="Index">Xem tất cả</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentDocuments.Count == 0)
                    {
                        <div class="text-center text-muted p-4 small">Chưa có tài liệu.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var d in Model.RecentDocuments)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div class="text-truncate me-2">
                                        <i class="bi bi-file-earmark-text text-primary me-1"></i>
                                        <strong>@(string.IsNullOrWhiteSpace(d.Title) ? d.FileName : d.Title)</strong>
                                    </div>
                                    <span class="small text-muted" style="white-space:nowrap;">@d.UploadedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header justify-content-between">
                    <span><i class="bi bi-chat-heart text-primary"></i>Góp ý mới nhất</span>
                    <a class="small" asp-controller="Feedback" asp-action="Manage">Quản lý</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentFeedback.Count == 0)
                    {
                        <div class="text-center text-muted p-4 small">Chưa có góp ý.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var f in Model.RecentFeedback)
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong class="text-truncate me-2">@f.UserName</strong>
                                        <span class="text-warning" style="white-space:nowrap;">
                                            @for (var i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= f.Rating ? "bi-star-fill" : "bi-star")" style="font-size:.75rem;"></i>
                                            }
                                        </span>
                                    </div>
                                    <div class="small text-muted text-truncate">@f.Content</div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-card { transition: transform .15s, box-shadow .15s; }
    .stat-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(0,0,0,.10); }
    .stat-ico {
        width: 48px; height: 48px; border-radius: 14px; margin: 0 auto;
        display: flex; align-items: center; justify-content: center;
        font-size: 22px; color: #fff;
    }
    .stat-indigo { background: linear-gradient(135deg,#6366f1,#4f46e5); }
    .stat-blue   { background: linear-gradient(135deg,#3b82f6,#2563eb); }
    .stat-violet { background: linear-gradient(135deg,#8b5cf6,#7c3aed); }
    .stat-teal   { background: linear-gradient(135deg,#14b8a6,#0d9488); }
    .stat-amber  { background: linear-gradient(135deg,#f59e0b,#d97706); }
    .stat-rose   { background: linear-gradient(135deg,#f43f5e,#e11d48); }
</style>
