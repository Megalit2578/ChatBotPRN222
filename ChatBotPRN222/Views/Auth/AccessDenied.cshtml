@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="error-page">
    <div class="error-card">
        <div class="ico"><i class="bi bi-shield-lock"></i></div>
        <div class="code">ERROR 403</div>
        <h2 class="mt-2 mb-2">Không có quyền truy cập</h2>
        <p class="text-muted mb-4">Tài khoản hiện tại của bạn không có quyền vào trang này. Vui lòng liên hệ Admin nếu cần được cấp quyền.</p>
        <div class="d-flex gap-2 justify-content-center">
            <a class="btn btn-brand" asp-controller="Chat" asp-action="Index">
                <i class="bi bi-house me-1"></i> Về trang chính
            </a>
            <a class="btn btn-outline-primary" asp-controller="Auth" asp-action="Logout">
                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
            </a>
        </div>
    </div>
</div>
