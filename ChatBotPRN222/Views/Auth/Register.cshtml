@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-hero">
        <div class="badge-pill">
            <i class="bi bi-person-plus"></i> Đăng ký miễn phí
        </div>
        <h1>Bắt đầu hành trình <span class="grad">học tập cùng AI</span></h1>
        <p class="lead">Tài khoản Student được tạo mặc định. Bạn có thể đăng nhập, đặt câu hỏi và xem trích dẫn từ tài liệu lớp ngay lập tức.</p>

        <div class="auth-features">
            <div class="auth-feature">
                <div class="ico"><i class="bi bi-lightning-charge-fill"></i></div>
                <div>
                    <p class="ttl">Hỏi đáp tức thời</p>
                    <p class="sub">Powered by Google Gemini, trả lời trong vài giây.</p>
                </div>
            </div>
            <div class="auth-feature">
                <div class="ico"><i class="bi bi-bookmark-star-fill"></i></div>
                <div>
                    <p class="ttl">Lịch sử hội thoại</p>
                    <p class="sub">Lưu lại mọi cuộc hội thoại để xem lại bất cứ lúc nào.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="auth-panel">
        <div class="auth-card">
            <div class="brand-block">
                <div class="brand-icon"><i class="bi bi-stars"></i></div>
                <div class="brand-text">ChatBot <span class="accent">PRN222</span></div>
            </div>

            <h2>Tạo tài khoản mới</h2>
            <p class="sub">Chỉ mất 30 giây — sẵn sàng dùng ngay</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label small"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-at"></i></span>
                        <input asp-for="Username" class="form-control" placeholder="vd: nguyenvana" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label small"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="ban@truong.edu.vn" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Password" class="form-label small"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmPassword" class="form-label small"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-brand w-100">
                    <i class="bi bi-check2-circle me-1"></i>Tạo tài khoản
                </button>
            </form>

            <div class="text-center small mt-3">
                Đã có tài khoản? <a asp-action="Login" class="fw-semibold">Đăng nhập →</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
