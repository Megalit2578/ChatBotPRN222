@model VerifyOtpViewModel
@{
    ViewData["Title"] = "Xác thực OTP";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-hero">
        <div class="badge-pill">
            <i class="bi bi-shield-lock"></i> Xác thực email
        </div>
        <h1>Nhập mã <span class="grad">OTP</span> để hoàn tất đăng ký</h1>
        <p class="lead">Chúng tôi đã gửi một mã gồm 6 chữ số tới email của bạn. Mã có hiệu lực trong 5 phút.</p>
    </div>

    <div class="auth-panel">
        <div class="auth-card">
            <div class="brand-block">
                <div class="brand-icon"><i class="bi bi-envelope-check"></i></div>
                <div class="brand-text">ChatBot <span class="accent">PRN222</span></div>
            </div>

            <h2>Xác thực tài khoản</h2>
            <p class="sub">Mã OTP đã gửi tới <strong>@Model.Email</strong></p>

            <form asp-action="VerifyOtp" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Code" class="form-label small"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <input asp-for="Code" class="form-control text-center" inputmode="numeric"
                               maxlength="6" autocomplete="one-time-code" autofocus
                               style="letter-spacing:8px;font-size:1.3rem;font-weight:600"
                               placeholder="______" />
                    </div>
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-brand w-100">
                    <i class="bi bi-check2-circle me-1"></i>Xác nhận
                </button>
            </form>

            <form asp-action="ResendOtp" method="post" class="mt-2">
                <button type="submit" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-clockwise me-1"></i>Gửi lại mã OTP
                </button>
            </form>

            <div class="text-center small mt-3">
                <a asp-action="Register" class="fw-semibold">← Quay lại đăng ký</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
