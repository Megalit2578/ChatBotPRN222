@model AllowedEmailIndexViewModel
@{
    ViewData["Title"] = "Email cho phép đăng ký";
}

<div class="page-shell">
    <div class="page-head">
        <div>
            <h1>
                <span class="ico"><i class="bi bi-envelope-check"></i></span>
                Email cho phép đăng ký
            </h1>
            <p class="sub">
                <span>Danh sách email được phép tạo tài khoản (whitelist)</span>
            </p>
        </div>
    </div>

    <div class="alert @(Model.WhitelistEnabled ? "alert-info" : "alert-warning") d-flex align-items-center">
        <i class="bi @(Model.WhitelistEnabled ? "bi-shield-lock" : "bi-unlock") me-2 fs-5"></i>
        @if (Model.WhitelistEnabled)
        {
            <span><strong>Whitelist đang BẬT.</strong> Chỉ những email trong danh sách dưới đây mới đăng ký được tài khoản.</span>
        }
        else
        {
            <span><strong>Whitelist đang TẮT.</strong> Danh sách trống nên <em>mọi email</em> đều có thể đăng ký. Thêm ít nhất 1 email để bật giới hạn.</span>
        }
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header grad"><i class="bi bi-plus-circle-fill"></i> Thêm email</div>
                <div class="card-body">
                    <form asp-action="Add" method="post">
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Email</label>
                            <input name="email" type="email" class="form-control" required
                                   placeholder="vd: sinhvien@fpt.edu.vn" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Ghi chú</label>
                            <input name="note" class="form-control" maxlength="300" placeholder="VD: SV khoá K17 (tuỳ chọn)" />
                        </div>
                        <button class="btn btn-brand w-100"><i class="bi bi-plus-lg me-1"></i>Thêm vào danh sách</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header justify-content-between">
                    <span><i class="bi bi-list-check text-primary"></i>Danh sách email <span class="badge bg-primary-subtle text-primary ms-1">@Model.Emails.Count</span></span>
                </div>
                <div class="card-body p-0">
                    @if (Model.Emails.Count == 0)
                    {
                        <div class="text-center p-5 text-muted">
                            <i class="bi bi-envelope-x" style="font-size:56px; opacity:.35; color: var(--c-primary);"></i>
                            <p class="mt-3 mb-0">Chưa có email nào trong danh sách.</p>
                            <p class="small mt-1">Đăng ký hiện đang mở cho mọi email.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Email</th>
                                        <th>Ghi chú</th>
                                        <th class="text-center">Thêm bởi</th>
                                        <th class="text-center">Thời gian</th>
                                        <th class="text-end">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in Model.Emails)
                                    {
                                        <tr>
                                            <td class="fw-semibold"><i class="bi bi-envelope me-1 text-primary"></i>@a.Email</td>
                                            <td class="small text-muted">@(string.IsNullOrWhiteSpace(a.Note) ? "—" : a.Note)</td>
                                            <td class="text-center small text-muted">@(string.IsNullOrWhiteSpace(a.AddedBy) ? "—" : a.AddedBy)</td>
                                            <td class="text-center small text-muted">@a.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="text-end">
                                                <form asp-action="Delete" method="post" class="m-0"
                                                      onsubmit="return confirm('Xoá email @a.Email khỏi danh sách cho phép?');">
                                                    <input type="hidden" name="id" value="@a.Id" />
                                                    <button class="btn btn-sm btn-outline-danger" title="Xoá"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
