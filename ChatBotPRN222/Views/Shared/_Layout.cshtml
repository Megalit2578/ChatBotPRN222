@{
    var isAuthed = User?.Identity?.IsAuthenticated == true;
    var fullName = User?.FindFirst("FullName")?.Value ?? User?.Identity?.Name;
    var role = User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var avatarPath = User?.FindFirst("AvatarPath")?.Value;
    var isAdmin = User?.IsInRole("Admin") == true;
    var isLecturer = User?.IsInRole("Lecturer") == true;
    var canManageDocs = isAdmin || isLecturer;
    var currentController = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var roleBadge = role switch
    {
        "Admin" => "bg-danger",
        "Lecturer" => "bg-warning text-dark",
        _ => "bg-info text-dark"
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · ChatBot PRN222</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (isAuthed)
    {
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top app-navbar">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-stars"></i></span>
                    <span class="ms-2">ChatBot <span class="text-info">PRN222</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i>Trang chủ
                            </a>
                        </li>
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Chat" ? "active" : "")" asp-controller="Chat" asp-action="Index">
                                <i class="bi bi-chat-dots me-1"></i>Hỏi đáp AI
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Document" ? "active" : "")" asp-controller="Document" asp-action="Index">
                                <i class="bi bi-folder2-open me-1"></i>Tài liệu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Chapter" ? "active" : "")" asp-controller="Chapter" asp-action="Index">
                                <i class="bi bi-bookmarks me-1"></i>Chương
                            </a>
                        </li>
                        @if (!isLecturer)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Feedback" && (ViewContext.RouteData.Values["action"] as string) == "Index" ? "active" : "")" asp-controller="Feedback" asp-action="Index">
                                    <i class="bi bi-chat-heart me-1"></i>Góp ý
                                </a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "User" ? "active" : "")" asp-controller="User" asp-action="Index">
                                    <i class="bi bi-people me-1"></i>Người dùng
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "AllowedEmail" ? "active" : "")" asp-controller="AllowedEmail" asp-action="Index">
                                    <i class="bi bi-envelope-check me-1"></i>Email cho phép
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Feedback" && (ViewContext.RouteData.Values["action"] as string) == "Manage" ? "active" : "")" asp-controller="Feedback" asp-action="Manage">
                                    <i class="bi bi-inboxes me-1"></i>Quản lý góp ý
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item me-3">
                            <a class="user-chip text-decoration-none"
                               asp-controller="Profile" asp-action="Index"
                               title="Xem hồ sơ">
                                @if (!string.IsNullOrEmpty(avatarPath))
                                {
                                    <img class="avatar-img" src="@avatarPath" alt="@fullName" />
                                }
                                else
                                {
                                    <div class="avatar">@((fullName ?? "U").Substring(0, 1).ToUpper())</div>
                                }
                                <div class="ms-2 d-none d-md-block">
                                    <div class="fw-semibold lh-1">@fullName</div>
                                    <span class="badge @roleBadge mt-1">@role</span>
                                </div>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sm btn-outline-light" asp-controller="Auth" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    }

    <main role="main">
        @if (TempData["Success"] is string s)
        {
            <div class="container mt-3"><div class="alert alert-success alert-dismissible fade show shadow-sm"><i class="bi bi-check-circle me-1"></i>@s<button class="btn-close" data-bs-dismiss="alert"></button></div></div>
        }
        @if (TempData["Error"] is string e)
        {
            <div class="container mt-3"><div class="alert alert-danger alert-dismissible fade show shadow-sm"><i class="bi bi-exclamation-triangle me-1"></i>@e<button class="btn-close" data-bs-dismiss="alert"></button></div></div>
        }
        @if (TempData["Warning"] is string w)
        {
            <div class="container mt-3"><div class="alert alert-warning alert-dismissible fade show shadow-sm"><i class="bi bi-exclamation-circle me-1"></i>@w<button class="btn-close" data-bs-dismiss="alert"></button></div></div>
        }
        @if (TempData["SuccessMessage"] is string sm)
        {
            <div class="container mt-3"><div class="alert alert-success alert-dismissible fade show shadow-sm"><i class="bi bi-check-circle me-1"></i>@sm<button class="btn-close" data-bs-dismiss="alert"></button></div></div>
        }
        @RenderBody()
    </main>

    @if (isAuthed)
    {
        <footer class="text-muted text-center small">
            <i class="bi bi-stars me-1 text-primary"></i>
            ChatBot PRN222 &copy; 2026
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.6/dist/purify.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
